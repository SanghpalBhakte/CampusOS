rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Strictly isolated per-user document storage
    match /users/{userId} {
      // Read access only for authenticated owner matching the document UID
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Write access only for authenticated owner matching the document UID with payload validation
      allow write: if request.auth != null 
                  && request.auth.uid == userId
                  && request.resource.data.keys().hasOnly(['profile', 'customTasks', 'assignmentStatuses', 'theme', 'updatedAt']);
    }
  }
}
