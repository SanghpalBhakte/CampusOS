rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all collections & unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict path-based per-user access control
    // Restricts root document and all subcollections under /users/{uid}/ strictly to the authenticated owner
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
